{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advancedrules.dev/schemas/memory/acceptance_criteria.schema.json",
  "title": "Acceptance Criteria",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "priority": { "type": ["string", "number"] },
          "done": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

