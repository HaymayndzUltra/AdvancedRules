{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advancedrules.dev/schemas/candidates.schema.json",
  "title": "Decision Candidates",
  "type": "object",
  "required": ["candidates"],
  "properties": {
    "context": { "type": "object" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action_type"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "action_type": { "type": "string" },
          "risk": { "type": "string" },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "intent": { "type": "number" },
              "state": { "type": "number" },
              "evidence": { "type": "number" },
              "recency": { "type": "number" },
              "pref": { "type": "number" },
              "cost": { "type": "number" },
              "risk_penalty": { "type": "number" }
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "intent": { "type": "number" },
              "state": { "type": "number" },
              "evidence": { "type": "number" },
              "recency": { "type": "number" },
              "pref": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}

