{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advancedrules.dev/schemas/candidates.schema.json",
  "title": "AdvancedRules Decision Candidates (Canonical)",
  "description": "Canonical schema for decision candidates consumed by advanced_score",
  "type": ["array", "object"],
  "anyOf": [
    { "$ref": "#/definitions/candidateArray" },
    {
      "type": "object",
      "required": ["candidates"],
      "properties": {
        "context": { "type": "object" },
        "candidates": { "$ref": "#/definitions/candidateArray" }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "candidateArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/candidate" }
    },
    "candidate": {
      "type": "object",
      "required": ["id", "action_type", "risk", "scores"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action_type": { "type": "string", "enum": ["NATURAL_STEP", "COMMAND_TRIGGER"] },
        "risk": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "explanation": { "type": "string" },
        "preconds": { "type": "array", "items": { "type": "string" } },
        "scores": {
          "type": "object",
          "required": ["intent", "state", "evidence", "recency", "pref", "cost", "risk_penalty"],
          "properties": {
            "intent": { "type": "number", "minimum": 0, "maximum": 1 },
            "state": { "type": "number", "minimum": 0, "maximum": 1 },
            "evidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "recency": { "type": "number", "minimum": 0, "maximum": 1 },
            "pref": { "type": "number", "minimum": 0, "maximum": 1 },
            "cost": { "type": "number", "minimum": 0, "maximum": 1 },
            "risk_penalty": { "type": "number", "minimum": 0, "maximum": 1 },
            "final": { "type": "number" },
            "final_raw": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}