schema_version: "1.0.0"
project: "Freelance Developer Personal Booking Website"

epics:
  - id: marketing-site
    title: Marketing Site
    tasks:
      - id: home-page-with-clear-cta
        desc: Home Page with Clear CTA
        acceptance:
          - Responsive hero section (desktop/tablet/mobile)
          - Prominent CTA (“Book Now” / “Hire Me”)
          - Services summary and trust signals (logos/testimonials)
          - Fast LCP (≤ 2.5s on 4G)
      - id: about-me
        desc: About Me
        acceptance:
          - Markdown/JSON-driven content
          - Downloadable CV link (optional)
          - Accessibility (WCAG 2.1 AA for text/contrast)
      - id: portfolio
        desc: Portfolio
        acceptance:
          - Project cards with tags and detail pages
          - Case study layout (problem/solution/outcomes)
          - Testimonial carousel or quotes section
      - id: services-pricing
        desc: Services & Pricing
        acceptance:
          - Pricing table (hourly/packages)
          - “Book Now” CTA per plan
          - FAQ block (revisions, scope, timeline)
  - id: booking-flow-integration
    title: Booking Flow Integration
    tasks:
      - id: booking-widget
        desc: Booking Widget
        acceptance:
          - Embedded/launch widget with configurable link
          - Timezone handling & confirmations
          - Availability sync visible
      - id: policies-notifications
        desc: Policies & Notifications
        acceptance:
          - Policy page linked from booking
          - Email templates for confirm/reschedule/cancel
          - Optional ICS calendar attachment
      - id: calendar-sync-optional
        desc: Calendar Sync (Optional)
        acceptance:
          - Basic sync or documented manual mode
          - Logging for sync attempts/errors
  - id: payments
    title: Payments
    tasks:
      - id: checkout
        desc: Checkout
        acceptance:
          - Test + live mode switch via env
          - Line items for packages/deposits
          - Success/failure redirects
      - id: webhooks-receipts
        desc: Webhooks & Receipts
        acceptance:
          - Signature verification
          - Persist TX status and receipt link
          - Email receipt to client
  - id: contact-social
    title: Contact & Social
    tasks:
      - id: contact-form
        desc: Contact Form
        acceptance:
          - Spam controls (honeypot/recaptcha)
          - Email delivery & success toast
          - Rate‑limit or basic throttle
      - id: social-links
        desc: Social Links
        acceptance:
          - LinkedIn/GitHub links
          - Open in new tab with rel=noopener
  - id: admin-dashboard
    title: Admin Dashboard
    tasks:
      - id: manage-bookings-inquiries
        desc: Manage Bookings & Inquiries
        acceptance:
          - Filter/search/status updates
          - CSV export for payments/inquiries
      - id: settings
        desc: Settings
        acceptance:
          - Booking link, payment keys, SEO meta
          - Feature flags (test/live)
  - id: seo-security
    title: SEO & Security
    tasks:
      - id: seo-ssl-security-headers
        desc: SEO/SSL/Security Headers
        acceptance:
          - Meta tags, sitemap, robots, OpenGraph
          - SSL cert + security headers
          - Lighthouse SEO ≥ 90
  - id: deployment-documentation
    title: Deployment & Documentation
    tasks:
      - id: staging-production-docs
        desc: Staging/Production & Docs
        acceptance:
          - Staging deploy (Docker/Vercel)
          - Environment variables documented
          - README + runbook + troubleshooting
